# ここは合言葉ではない。切り替えの札だけを置く。
# 鍵（OPENAI_API_KEY）は Secret Manager にしかない。ここには書かない。
#
# このファイルは deploy のときにも、動いているときにも読まれる。
# だから札は1か所でそろう。
#
# HP_IMAGE   ヒーローの絵を作る窓口（/api/image）を出すか
#              0 … 出さない（既定）
#              1 … 出す。次の3つが済んでいること
#                   ① Secret Manager API を有効にする
#                   ② firebase functions:secrets:set OPENAI_API_KEY
#                   ③ ここを 1 にして push
#
# 0 のあいだ、編集画面の「絵を作ってもらう」は出たままになる。
# 押すと「窓口がまだ出ていません」と返る（黙って失敗しないようにしてある）。
HP_IMAGE=0

# HP_SITE_BASE   公開ページのアドレスの頭
# HP_API_ORIGIN  公開ページから問い合わせを送ってよい先
#
# 既定（書かないとき）は、どちらも同じドメイン。
#   HP_SITE_BASE  … https://<プロジェクト>.web.app/s/
#   HP_API_ORIGIN … 'self'（同じドメイン）
#
# 公開ページを別のドメインへ移すときだけ、両方いっしょに書く。
# 片方だけだと、アドレスは変わったのに問い合わせが送れない、になる。
# 手順は firebase/README.md の「公開ページを、別のドメインに移す」。
#
# HP_SITE_BASE=https://bildy-4e45e-pages.web.app/s/
# HP_API_ORIGIN=https://bildy-4e45e.web.app
