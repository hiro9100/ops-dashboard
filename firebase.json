{
  "hosting": {
    "public": "docs",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/art/**",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
        ]
      }
    ],
    "rewrites": [
      { "source": "/s/**", "function": { "functionId": "serveSite", "region": "asia-northeast1" } },
      { "source": "/api/publish", "function": { "functionId": "publishSite", "region": "asia-northeast1" } },
      { "source": "/api/form", "function": { "functionId": "submitForm", "region": "asia-northeast1" } },
      { "source": "/api/messages", "function": { "functionId": "listMessages", "region": "asia-northeast1" } },
      { "source": "/api/image", "function": { "functionId": "generateImage", "region": "asia-northeast1" } }
    ]
  },
  "storage": { "rules": "hp-builder/firebase/storage.rules" },
  "firestore": {
    "rules": "hp-builder/firebase/firestore.rules",
    "indexes": "hp-builder/firebase/firestore.indexes.json"
  },
  "functions": { "source": "hp-builder/firebase/functions" }
}
